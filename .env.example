# Copier ce fichier en .env (ou définir ces variables au niveau du système /
# de l'utilisateur Windows) — NE JAMAIS committer de vraie clé.

# APPLICATION_ID obtenu sur https://portail-api.meteofrance.fr/
# ("Mes API" > choisir l'API > "Générer Token" > valeur après "Authorization: Basic ")
METEOFRANCE_APPLICATION_ID=

# Optionnel : force le produit ANTILOPE/LAME_D_EAU à utiliser si la détection
# automatique du catalogue échoue (nom exact tel que retourné par
# GET https://public-api.meteofrance.fr/public/DPRadar/v1/mosaiques/METROPOLE/observations)
METEOFRANCE_OBSERVATION=

# Optionnel : chemin du CSV partagé (défaut : ./precip_yavannome.csv)
PRECIP_CSV_PATH=
