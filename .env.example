# Copier ce fichier en .env (ou définir ces variables au niveau du système /
# de l'utilisateur Windows) — NE JAMAIS committer de vraie clé.

# APPLICATION_ID obtenu sur https://portail-api.meteofrance.fr/
# ("Mes API" > choisir l'API > "Générer Token" > valeur après "Authorization: Basic ")
METEOFRANCE_APPLICATION_ID=

# Optionnel : force le produit ANTILOPE/LAME_D_EAU à utiliser si la détection
# automatique du catalogue échoue (nom exact tel que retourné par
# GET https://public-api.meteofrance.fr/public/DPRadar/v1/mosaiques/METROPOLE/observations)
METEOFRANCE_OBSERVATION=

# Optionnel : chemin du CSV partagé (défaut : ./precip_yavannome.csv)
PRECIP_CSV_PATH=

# Module Sol / Hydrologie. SIM (Météo-France) est public : aucune clé.
# .env n'est pas chargé automatiquement : définir ces variables dans le
# système, ou en secrets GitHub Actions (mêmes noms) pour l'Action quotidienne.
HYDRO_CACHE_PATH=.cache/soil_hydrology.sqlite

# Copernicus CLMS (SWI/SSM 1 km) — compte gratuit https://dataspace.copernicus.eu/
# Option recommandée : clés S3 (https://eodata-s3keysmanager.dataspace.copernicus.eu/)
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
# Option alternative : identifiants du compte (jeton OIDC)
CDSE_USERNAME=
CDSE_PASSWORD=

# ERA5-Land (optionnel, --provider era5) : accepter la licence sur le portail CDS.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
