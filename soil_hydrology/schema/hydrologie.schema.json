{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nicolasdbs8/precip-yavannome/soil_hydrology/schema/hydrologie.schema.json",
  "title": "Rain — hydrologie locale de la parcelle (schema_version 1)",
  "type": "object",
  "required": ["schema_version", "generated_at", "parcel", "limits", "conventions", "sources", "comparisons"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "generator": {"type": "string"},
    "limits": {"type": "string", "minLength": 20},
    "parcel": {
      "type": "object",
      "required": ["insee", "section", "number", "idu", "area_m2", "centroid", "bbox_wgs84", "geometry", "geometry_source"],
      "properties": {
        "insee": {"type": "string", "pattern": "^[0-9AB]{5}$"},
        "section": {"type": "string"},
        "number": {"type": "string", "pattern": "^[0-9]{4}$"},
        "idu": {"type": "string", "minLength": 14, "maxLength": 14},
        "area_m2": {"type": "number", "exclusiveMinimum": 0},
        "centroid": {"type": "object", "required": ["lat", "lon"],
                     "properties": {"lat": {"type": "number", "minimum": -90, "maximum": 90},
                                    "lon": {"type": "number", "minimum": -180, "maximum": 180}}},
        "bbox_wgs84": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
        "geometry": {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"const": "MultiPolygon"}}},
        "geometry_source": {"type": "object", "required": ["provider", "url", "retrieved_at"]}
      }
    },
    "conventions": {"type": "object", "required": ["null", "zero", "status", "no_cross_source_average"],
                    "properties": {"no_cross_source_average": {"const": true}}},
    "sources": {
      "type": "object",
      "required": ["sim", "copernicus_swi", "copernicus_ssm", "era5_land", "rain_precipitation"],
      "properties": {
        "sim": {"allOf": [{"$ref": "#/$defs/block"}, {"$ref": "#/$defs/sim"}]},
        "copernicus_swi": {"allOf": [{"$ref": "#/$defs/block"}, {"$ref": "#/$defs/raster"}]},
        "copernicus_ssm": {"allOf": [{"$ref": "#/$defs/block"}, {"$ref": "#/$defs/raster"}]},
        "era5_land": {"allOf": [{"$ref": "#/$defs/block"}, {"$ref": "#/$defs/raster"}]},
        "rain_precipitation": {"$ref": "#/$defs/block"}
      },
      "additionalProperties": false
    },
    "comparisons": {"type": "object", "required": ["precipitation_sim_vs_rain"]}
  },
  "$defs": {
    "nullable_number": {"type": ["number", "null"]},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "block": {
      "type": "object",
      "required": ["status", "status_reason", "source_date", "valid_until", "age_hours", "max_age_hours", "messages"],
      "properties": {
        "status": {"enum": ["FRESH", "STALE", "PARTIAL", "UNAVAILABLE", "UNAVAILABLE_AUTH", "ERROR", "DISABLED"]},
        "status_reason": {"type": "string"},
        "source_date": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "valid_until": {"type": ["string", "null"]},
        "age_hours": {"$ref": "#/$defs/nullable_number"},
        "max_age_hours": {"type": ["integer", "null"]},
        "messages": {"type": "array", "items": {"type": "string"}},
        "carried_over_from": {"type": "string"}
      }
    },
    "series": {
      "type": "object", "required": ["date"],
      "properties": {"date": {"type": "array", "items": {"$ref": "#/$defs/date"}}},
      "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/nullable_number"}}
    },
    "sim": {
      "properties": {
        "units": {"type": "object", "additionalProperties": {"type": "string"}},
        "grids": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "lambx_hm", "lamby_hm", "lat", "lon", "role", "overlap_fraction", "distance_m", "latest", "derived", "series"],
            "properties": {
              "lambx_hm": {"type": "integer"}, "lamby_hm": {"type": "integer"},
              "role": {"enum": ["parcel", "adjacent"]},
              "overlap_fraction": {"type": "number", "minimum": 0, "maximum": 1},
              "series": {"$ref": "#/$defs/series"},
              "latest": {"type": ["object", "null"], "required": ["date", "values"],
                         "properties": {"values": {"type": "object", "additionalProperties": {"$ref": "#/$defs/nullable_number"}}}},
              "derived": {"type": ["object", "null"], "required": ["anchor_date", "swi", "cumuls_mm", "missing_days"],
                          "properties": {"swi": {"$ref": "#/$defs/trend"}}}
            }
          }
        }
      }
    },
    "raster": {
      "properties": {
        "unit": {"type": "string"},
        "pixels": {"type": "array", "items": {"type": "object", "required": ["id", "latest", "derived", "series"],
                                               "properties": {"series": {"$ref": "#/$defs/series"}}}}
      }
    },
    "trend": {
      "type": "object", "required": ["latest", "latest_date", "d7", "d7_date", "delta_7d", "trend"],
      "properties": {
        "latest": {"$ref": "#/$defs/nullable_number"}, "d7": {"$ref": "#/$defs/nullable_number"},
        "delta_7d": {"$ref": "#/$defs/nullable_number"},
        "trend": {"enum": ["rising", "stable", "falling", null]}
      }
    }
  }
}
